/**
 * @name 同程旅行 - 纯查询版【只查状态、里程、任务】
 * 命令行调用：node 脚本.js wxid
 */

const https = require('https');
const http = require('http');
const zlib = require('zlib');

const BASE_URL = 'https://wx.17u.cn';
const SIGN_URL = BASE_URL + '/wxmpsign/sign';
const HOME_URL = BASE_URL + '/wxmpsign/home';
const TASK_URL = BASE_URL + '/qiushiinnerapi/task';
const LOGIN_URL = BASE_URL + '/wechatappapi/wxUser/login';

const GET_USER_PARTICIPATION = BASE_URL + '/wxmpsign/share/mileage/getUserParticipationInfo';
const FLOWER_BASE = BASE_URL + '/platformflowpool/flowerGod';
const FLOWER_HOME = FLOWER_BASE + '/home';
const FLOWER_CARD_LIST = FLOWER_BASE + '/cardList';

const CARD_TYPE_MAP = {
  0: '花神签(稀有)', 1: '牡丹签', 2: '梨花签', 3: '荷花签', 4: '桃花签', 5: '梅花签'
};
const ALL_CARD_TYPES = [0,1,2,3,4,5];
const WECHAT_SERVER = process.env.WECHAT_SERVER || 'http://180.152.5.230:8011';
const DEFAULT_APPID = process.env.TC_APPID || 'wx336dcaf6a1ecf632';

function getEnv(n) { return process.env[n] || ''; }
function pad2(n) { return n < 10 ? '0' + n : '' + n; }

function generateApmat(openid) {
  openid = openid || 'o498X0ScTl0oO6aj0taIYuXYvM9I';
  const now = new Date();
  const ts = '' + now.getFullYear() + pad2(now.getMonth()+1) + pad2(now.getDate()) + pad2(now.getHours()) + pad2(now.getMinutes());
  const rand = Math.floor(Math.random() * 900000) + 100000;
  return openid + '|' + ts + '|' + rand;
}

function httpRequest(url, method, headers, body) {
  return new Promise((resolve, reject) => {
    const urlObj = new URL(url);
    const isHttps = urlObj.protocol === 'https:';
    const lib = isHttps ? https : http;
    const port = urlObj.port || (isHttps ? 443 : 80);
    const req = lib.request({ hostname: urlObj.hostname, port, path: urlObj.pathname + urlObj.search, method, headers }, (res) => {
      const encoding = (res.headers['content-encoding'] || '').toLowerCase();
      let stream = res;
      if (encoding === 'gzip') stream = res.pipe(zlib.createGunzip());
      else if (encoding === 'deflate') stream = res.pipe(zlib.createInflate());
      else if (encoding === 'br') stream = res.pipe(zlib.createBrotliDecompress());
      const chunks = [];
      stream.on('data', c => chunks.push(Buffer.isBuffer(c) ? c : Buffer.from(c)));
      stream.on('end', () => {
        const data = Buffer.concat(chunks).toString('utf8');
        try { resolve(JSON.parse(data)); } catch(e) { resolve({ raw: data }); }
      });
      stream.on('error', reject);
    });
    req.on('error', reject);
    if (body && (method === 'POST' || method === 'PUT')) req.write(typeof body === 'string' ? body : JSON.stringify(body));
    req.end();
  });
}

async function getWxCode(wxid, appid) {
  const res = await httpRequest(WECHAT_SERVER + '/api/v1/wx/app/get/code', 'POST', { 'Content-Type': 'application/json' }, { appid, wxid });
  if (res.Code === 0 || res.code === 0) return res.Data?.code || res.data?.code || res.Data;
  if (res.Success || res.status) return res.Data?.code || res.data?.code || res.Data;
  throw new Error('获取微信code失败');
}

async function tcLogin(wxCode) {
  const res = await httpRequest(LOGIN_URL, 'POST', { 'Content-Type': 'application/json' }, { code: wxCode, scene: '1001' });
  const content = res.data?.content || res.content || {};
  if (!content.sectoken) throw new Error('登录失败，未返回token');
  return {
    tcsectk: content.sectoken,
    mallUserToken: content.sectoken,
    openid: content.openId,
    unionid: content.unionId
  };
}

// ====================== 命令行支持（修复名称） ======================
function parseAccounts() {
  const cliWxid = process.argv[2]?.trim();
  if (cliWxid) {
    return [{
      wxid: cliWxid,
      appid: DEFAULT_APPID,
      remark: "账号1",
      index: 1
    }];
  }

  const raw = getEnv('WXID_TC');
  if (!raw) return [];

  const lines = raw.split(/[&\n]/).map(x => x.trim()).filter(Boolean);
  return lines.map((line, i) => {
    const p = line.split('#');
    const remark = p.length > 1 ? p[0].trim() : `账号${i+1}`;
    const wxid = p.length > 1 ? p[1].trim() : p[0].trim();
    if (!wxid) return null;
    return { wxid, appid: DEFAULT_APPID, remark, index: i+1 };
  }).filter(Boolean);
}

function buildHeaders(acct) {
  return {
    'Content-Type': 'application/json',
    'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 16_3_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 MicroMessenger/8.0.60 NetType/WIFI',
    'tcsectk': acct.tcsectk, 'TCSecTk': acct.tcsectk,
    'tc-mall-platform-code': 'WX_MP', 'tc-mall-user-token': acct.mallUserToken,
    'secToken': acct.mallUserToken, 'platform': 'WX_MP', 'osType': '1',
    'apmat': generateApmat(acct.openid)
  };
}

function buildFlowerHeaders(acct) {
  return {
    'Content-Type': 'application/json;charset=UTF-8',
    'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 16_3_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 MicroMessenger/8.0.60',
    'Referer': 'https://wx.17u.cn/wxweb/',
    'Origin': 'https://wx.17u.cn',
    'platform': 'WX_MP', 'TC-PLATFORM-CODE': 'WX_MP',
    'TC-USER-TOKEN': acct.tcsectk, 'secToken': acct.tcsectk
  };
}

function request(method, url, headers, body) {
  return new Promise((resolve, reject) => {
    const urlObj = new URL(url);
    const bodyStr = body ? JSON.stringify(body) : null;
    const req = https.request({
      hostname: urlObj.hostname, port: 443,
      path: urlObj.pathname + urlObj.search,
      method, headers
    }, (res) => {
      let stream = res;
      const enc = (res.headers['content-encoding'] || '').toLowerCase();
      if (enc === 'gzip') stream = res.pipe(zlib.createGunzip());
      else if (enc === 'deflate') stream = res.pipe(zlib.createInflate());
      else if (enc === 'br') stream = res.pipe(zlib.createBrotliDecompress());
      const buf = [];
      stream.on('data', c => buf.push(c));
      stream.on('end', () => {
        const txt = Buffer.concat(buf).toString('utf8');
        try { resolve(JSON.parse(txt)); } catch { resolve({ raw: txt }); }
      });
      stream.on('error', reject);
    });
    req.on('error', reject);
    if (bodyStr) req.write(bodyStr);
    req.end();
  });
}

// ===== 查询接口 =====
const getSignInfo = h => request('POST', SIGN_URL + '/getSignInfo', h, {});
const getHomeTop = h => request('POST', HOME_URL + '/top', h, {});
const getTaskList = h => request('POST', TASK_URL + '/detailList', h, {
  detailGuid: '', pageNum: 1, pageSize: 999, schemeGuid: 'task-2025-nflygijg'
});

function getTodayRange() {
  const now = new Date();
  const d = `${now.getFullYear()}-${pad2(now.getMonth()+1)}-${pad2(now.getDate())}`;
  return { startDate: d + ' 00:00:00', endDate: d + ' 23:59:59' };
}
const getUserShareInfo = h => {
  const { startDate, endDate } = getTodayRange();
  return request('POST', GET_USER_PARTICIPATION, h, { startDate, limitAmount:1, endDate });
};

const getFlowerHome = fh => request('GET', FLOWER_HOME, fh);

function getStatusText(st) {
  const m = {0:'⏳ 未做',1:'🔄 进行中',2:'✅ 待领取',3:'🎁 已完成'};
  return m[st] || '❓ 未知';
}

// ====================== 现金打卡查询 ======================
async function queryCashClockin(acct) {
  const headers = {
    ...buildHeaders(acct),
    "TC-MALL-PLATFORM-CODE": "WX_MP",
    "platform": "WX_H5"
  };
  try {
    const r = await request('POST', BASE_URL + '/wxmpsign/clockin/getClockinInfo', headers, {
      "channel": "923f1661d1e24aa399f0e4e6ba0b0fba"
    });
    if (r?.code === 0) {
      const d = r.data || {};
      return {
        todayClocked: d.isTodayClocked,
        totalAmount: d.totalAmount || 0
      };
    }
  } catch (e) {}
  return null;
}

// ====================== 里程瓜分查询 ======================
async function queryShareMileage(h) {
  try {
    const r = await getUserShareInfo(h);
    if (r?.code !== 200) return { enrolled: false, todayCheck: false };
    const list = r.data || [];
    const today = list[0];
    return {
      enrolled: !!today,
      todayCheck: today?.finishStatus === 1
    };
  } catch (e) {
    return { enrolled: false, todayCheck: false };
  }
}

// ====================== 花神查询 ======================
async function queryFlower(acct) {
  const fh = buildFlowerHeaders(acct);
  const home = await getFlowerHome(fh);
  if (home?.code !== 0) return '未开启';
  const cards = home.data?.cardList || [];
  const total = cards.reduce((s,x) => s + (x.cardCount||0), 0);
  return `已收集 ${total} 张`;
}

// ====================== 任务列表 ======================
async function queryTasks(h) {
  const res = await getTaskList(h);
  if (res?.code !== 0) return [];
  return res.data?.taskDetails || [];
}

// ====================== 主逻辑 ======================
async function runAccount(cfg) {
  console.log(`\n┌────── ${cfg.remark} ──────┐`);
  let acct;
  try {
    const code = await getWxCode(cfg.wxid, cfg.appid);
    acct = await tcLogin(code);
    console.log(`│ ✅ 登录成功`);
  } catch (e) {
    console.log(`│ ❌ 登录失败：${e.message}`);
    console.log(`└────────────────────────────┘`);
    return;
  }

  const h = buildHeaders(acct);

  // 里程
  const home = await getHomeTop(h);
  const mileage = home?.data?.remainCoin || 0;
  console.log(`│ 💰 总里程：${mileage}`);

  // 签到
  const sign = await getSignInfo(h);
  const todaySigned = sign?.data?.todaySigned || false;
  const signDays = sign?.data?.periodContinuedSignDays || 0;
  console.log(`│ 📅 签到：${todaySigned ? '✅ 已签' : '⬜ 未签'} | 连续 ${signDays} 天`);

  // 现金打卡
  const cash = await queryCashClockin(acct);
  if (cash) {
    console.log(`│ 💴 现金打卡：${cash.todayClocked ? '✅ 已打' : '⬜ 未打'} | 累计 ¥${cash.totalAmount}`);
  }

  // 里程瓜分
  const share = await queryShareMileage(h);
  console.log(`│ 🏆 里程瓜分：${share.enrolled ? '✅ 已报名' : '⬜ 未报名'} | 今日打卡：${share.todayCheck ? '是' : '否'}`);

  // 花神
  const flower = await queryFlower(acct);
  console.log(`│ 🌸 花神祈福：${flower}`);

  // 任务
  const tasks = await queryTasks(h);
  console.log(`│`);
  console.log(`│ 📋 任务共 ${tasks.length} 个`);
  tasks.slice(0, 10).forEach(t => {
    console.log(`│  📌 ${t.title} | ${getStatusText(t.status)}`);
  });

  console.log(`└────────────────────────────┘`);
}

// ====================== 入口 ======================
(async () => {
  console.log('🚀 同程旅行查询');
  const list = parseAccounts();
  if (!list.length) {
    console.log('❌ 使用：node tc.js wxid');
    return;
  }
  for (const acc of list) await runAccount(acc);
  console.log('\n🎉 查询完成');
})();